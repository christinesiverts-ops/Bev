# Copy to .env and fill in.  cp .env.example .env

# Local port nginx proxies to (container listens on 127.0.0.1 only).
APP_PORT=8000

# Long random string that signs sessions. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# First manager account (only used when the database has no users yet).
# You'll be asked to change the password at first sign-in. You can delete these two lines afterwards.
ADMIN_USERNAME=manager
ADMIN_PASSWORD=

# Local time zone for "today", promo status and nightly backups.
TZ_NAME=America/Los_Angeles

# Optional
# BACKUP_HOUR=2            # local hour for the nightly database backup
# BACKUP_KEEP=14           # how many nightly backups to keep
# GPS_FLAG_METERS=300      # check-ins farther than this from the store are flagged
# SESSION_HOURS=12
# MAX_PHOTO_MB=15
